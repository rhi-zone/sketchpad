strict_env

if ! has nix_direnv_version || ! nix_direnv_version 3.0.4; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.4/direnvrc" "sha256-DzlYZ33mWF/Gs8DDeyjr8mnVmQGx7ASYqA5WlxwvBG4="
fi

# Auto-detect GPU and use the appropriate devShell.
# Priority: CUDA > ROCm > default (wgpu/CPU).
if [[ -e /run/opengl-driver/lib/libcuda.so ]]; then
  # NVIDIA: libcuda.so is exposed by the system NVIDIA driver via NixOS opengl-driver
  NIXPKGS_ALLOW_UNFREE=1 use flake .#cuda --impure
elif [[ -e /dev/kfd ]]; then
  # AMD: /dev/kfd is the ROCm kernel fusion driver, present on all AMD dGPU systems with ROCm.
  # This shell provides both wgpu/Vulkan (default features) and ROCm/HIP (--features rocm).
  use flake .#amd
else
  use flake
fi
