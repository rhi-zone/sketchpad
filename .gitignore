# build output
target/

# generated images
*.png

# environment variables
.env

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# direnv
.direnv/

# Node.js / Bun
node_modules/
bun.lockb

# VitePress
docs/.vitepress/cache/
docs/.vitepress/dist/

# Moss - ignore generated files but keep config
.moss/*
!.moss/config.toml
!.moss/duplicate-functions-allow
!.moss/duplicate-types-allow
!.moss/hotspots-allow
!.moss/large-files-allow
!.moss/memory/

# Normalize
.normalize/*
!.normalize/config.toml
!.normalize/duplicate-functions-allow
!.normalize/duplicate-types-allow
!.normalize/hotspots-allow
!.normalize/large-files-allow
!.normalize/memory/
