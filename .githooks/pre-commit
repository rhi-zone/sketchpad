#!/usr/bin/env bash
set -e

echo "Running cargo fmt..."
staged=$(git diff --cached --name-only)
cargo fmt --all
if [ -n "$staged" ]; then
  echo "$staged" | xargs git add
fi

echo "Running cargo clippy..."
# Run clippy per-crate on changed crates to avoid pulling in tracel-llvm
# (cubecl unconditionally depends on it, and NixOS can't run the binary)
changed_crates=$(git diff --cached --name-only | grep '^crates/' | sed 's|^crates/\([^/]*\)/.*|\1|' | sort -u)
if [ -n "$changed_crates" ]; then
  for crate in $changed_crates; do
    cargo clippy -p "$crate" --all-targets -- -D warnings
  done
else
  # Non-crate changes — just check the workspace lib
  cargo clippy -p sketchpad --all-targets -- -D warnings
fi

echo "Pre-commit checks passed!"
